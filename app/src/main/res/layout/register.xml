<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Ui.Login">

    <!-- 背景图 -->
    <ImageView
        android:id="@+id/ivBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/login_picture3"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- 白色薄纱：压一下背景细节，保证文字清楚 -->
    <View
        android:id="@+id/vScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#1FFFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/registerTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="120dp"
        android:text="注册"
        android:textSize="40sp"
        android:letterSpacing="0.12"
        android:fontFamily="serif"
        app:layout_constraintTop_toTopOf="parent"
        android:gravity="center"/>

    <EditText
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:id="@+id/etAccount"
        android:hint="请输入账号（不大于12位）"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintTop_toBottomOf="@id/registerTitle"
        android:layout_marginTop="64dp"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>

    <EditText
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:id="@+id/etPassword"
        android:hint="请输入密码（不小于6位）"
        android:inputType="textPassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="56dp"
        app:layout_constraintTop_toBottomOf="@id/etAccount"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>

    <ImageView
        android:id="@+id/ivTogglePassword"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:src="@drawable/ic_visibility_off"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/etPassword"
        app:layout_constraintBottom_toBottomOf="@id/etPassword"
        android:layout_marginEnd="12dp" />

    <Button
        android:id="@+id/btnLogin"
        android:text="注册"
        android:backgroundTint="#A3C57D"
        android:textColor="#FFFFFF"
        android:layout_width="0dp"
        android:layout_height="42dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintTop_toBottomOf="@id/etPassword"
        android:layout_marginTop="64dp"
        app:cornerRadius="12dp"  />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/toGoToLogin"
        android:text="已有账号？返回登录页"
        android:textSize="14sp"
        android:textColor="#4D4B4B"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/btnLogin"
        android:layout_marginTop="40dp"/>



</androidx.constraintlayout.widget.ConstraintLayout>
