<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 头像：先用绿色方块占位，以后换真图片 -->
    <View
        android:id="@+id/ivAvatar"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="40dp"
        android:background="#8BC34A"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 用户名：大字、粗体 -->
    <TextView
        android:id="@+id/tvUsername"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="test"
        android:textColor="#1A1A1A"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/ivAvatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center"/>

    <!-- 账号：小字、灰色 -->
    <TextView
        android:id="@+id/tvAccount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="账号 · test"
        android:textColor="#888888"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvUsername"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center"/>

    <!-- 分隔线：1dp 灰线 -->

    <View
        android:id="@+id/divider1"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="40dp"
        android:background="#EEEEEE"
        app:layout_constraintTop_toBottomOf="@id/tvAccount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvChangeNickname"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:text="修改昵称"
        android:textColor="#1A1A1A"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textSize="20sp"
        android:textColor="#CCCCCC"
        app:layout_constraintEnd_toEndOf="@id/tvChangeNickname"
        app:layout_constraintTop_toTopOf="@id/tvChangeNickname"
        app:layout_constraintBottom_toBottomOf="@id/tvChangeNickname" />

    <!-- 原来的"修改密码"，把它的上边距约束改成接在昵称下面 -->

    <TextView
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:id="@+id/tvChangePassword"
        android:text="修改密码"
        android:textSize="16sp"
        android:textColor="#1A1A1A"
        app:layout_constraintTop_toBottomOf="@id/tvChangeNickname"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center_vertical"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textSize="20sp"
        android:textColor="#CCCCCC"
        app:layout_constraintEnd_toEndOf="@id/tvChangePassword"
        app:layout_constraintTop_toTopOf="@id/tvChangePassword"
        app:layout_constraintBottom_toBottomOf="@id/tvChangePassword" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:id="@+id/tvAbout"
        android:text="关于"
        android:textSize="16sp"
        android:textColor="#1A1A1A"
        app:layout_constraintTop_toBottomOf="@id/tvChangePassword"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center_vertical"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textSize="20sp"
        android:textColor="#CCCCCC"
        app:layout_constraintEnd_toEndOf="@id/tvAbout"
        app:layout_constraintTop_toTopOf="@id/tvAbout"
        app:layout_constraintBottom_toBottomOf="@id/tvAbout" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:id="@+id/tvHistory"
        android:text="浏览记录"
        android:textSize="16sp"
        android:textColor="#1A1A1A"
        app:layout_constraintTop_toBottomOf="@id/tvAbout"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center_vertical"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textSize="20sp"
        android:textColor="#CCCCCC"
        app:layout_constraintEnd_toEndOf="@id/tvHistory"
        app:layout_constraintTop_toTopOf="@id/tvHistory"
        app:layout_constraintBottom_toBottomOf="@id/tvHistory" />

    <!-- 分隔线：1dp 灰线 -->

    <View
        android:id="@+id/divider2"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="40dp"
        android:background="#EEEEEE"
        app:layout_constraintTop_toBottomOf="@id/tvHistory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 以下是退出登录按钮 -->
    <Button
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/btnLogOut"
        android:text="退出登录"
        android:textSize="16sp"
        android:backgroundTint="#F81E18"
        android:textColor="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/divider2"
        android:layout_marginTop="56dp"/>

    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PoemApp v1.0"
        android:textSize="12sp"
        android:textColor="#CCCCCC"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnLogOut"
        android:layout_marginTop="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
