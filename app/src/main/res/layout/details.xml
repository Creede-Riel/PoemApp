<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:paddingBottom="48dp" >

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="150dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/login_picture3" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#33FFFFFF" />


        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="← 返回"
            android:textSize="16sp"
            android:textColor="#333333"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

        <!-- 标题 -->
        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="静夜思"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A" />


        <!-- 作者 · 朝代 -->
        <TextView
            android:id="@+id/tvDetailAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="李白 · 唐代"
            android:textSize="16sp"
            android:textColor="#404040" />

            <!-- 体裁 · 合集 -->
            <TextView
                android:id="@+id/tvDetailMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="五言绝句 · 唐诗三百首"
                android:textSize="13sp"
                android:textColor="#404040" />

        </LinearLayout>

    </FrameLayout>




        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#EEEEEE" />

        <!-- 原文 -->
        <TextView
            android:id="@+id/tvDetailContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="床前明月光，疑是地上霜。"
            android:textSize="18sp"
            android:textColor="#1A1A1A"
            android:lineSpacingExtra="10dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp" >

            <Button
                android:id="@+id/btnSpeak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊 朗读"
                android:textSize="14sp"
                android:backgroundTint="#9BD060"/>

            <Button
                android:id="@+id/btnFavorite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☆ 收藏"
                android:textSize="14sp"
                android:textColor="#7CB342"
                android:backgroundTint="#FFFFFF"
                app:strokeColor="#7CB342"
                app:strokeWidth="1dp" />

        </LinearLayout>




        <!-- 注释 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="【注释】"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#8BC34A" />

        <TextView
            android:id="@+id/tvDetailNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="疑：好像。"
            android:textSize="15sp"
            android:textColor="#444444"
            android:lineSpacingExtra="6dp" />

        <!-- 译文 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="【译文】"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#8BC34A" />

        <TextView
            android:id="@+id/tvDetailTranslate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="……"
            android:textSize="15sp"
            android:textColor="#444444"
            android:lineSpacingExtra="6dp" />

        <!-- 赏析 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="【赏析】"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#8BC34A" />

        <TextView
            android:id="@+id/tvDetailAppreciation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="……"
            android:textSize="16sp"
            android:textColor="#444444"
            android:lineSpacingExtra="10dp" />

        <!-- 作者简介 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="【作者】"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#8BC34A" />

        <TextView
            android:id="@+id/tvDetailAuthorBio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="……"
            android:textSize="15sp"
            android:textColor="#444444"
            android:lineSpacingExtra="6dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="#EEEEEE" />


        <!-- 相关主题 -->
        <TextView
            android:id="@+id/tvTagLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="相关主题"
            android:textColor="#666666"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="8dp"
            app:singleLine="true" />

    </LinearLayout>



</ScrollView>